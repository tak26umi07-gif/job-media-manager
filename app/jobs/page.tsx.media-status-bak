"use client";

import { useEffect, useMemo, useState } from "react";
import Link from "next/link";

type JobMedia = {
  id: string;
  media: "INDEED" | "JOB_BOX" | "ENGAGE" | "OTHER";
  status:
    | "NOT_PUBLISHED"
    | "PENDING"
    | "PUBLISHED"
    | "ERROR"
    | "CLOSED";
};

type Job = {
  id: string;
  title: string;
  location: string;
  employmentType: string;
  salary: string;
  status: "DRAFT" | "READY" | "PUBLISHED" | "CLOSED";
  updatedAt: string;
  company: {
    name: string;
  };
  mediaListings: JobMedia[];
};

const statusOptions = [
  { value: "ALL", label: "すべて" },
  { value: "DRAFT", label: "下書き" },
  { value: "READY", label: "掲載準備完了" },
  { value: "PUBLISHED", label: "掲載中" },
  { value: "CLOSED", label: "掲載終了" },
];

const mediaNames: Record<JobMedia["media"], string> = {
  INDEED: "Indeed",
  JOB_BOX: "JOB BOX",
  ENGAGE: "engage",
  OTHER: "その他",
};

export default function JobsPage() {
  const [jobs, setJobs] = useState<Job[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("ALL");

  useEffect(() => {
    const fetchJobs = async () => {
      try {
        setLoading(true);

        const response = await fetch("/api/jobs", {
          cache: "no-store",
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            data.error || "求人の取得に失敗しました"
          );
        }

        setJobs(data.jobs || []);
      } catch (error) {
        console.error(error);

        setError(
          error instanceof Error
            ? error.message
            : "求人の取得に失敗しました"
        );
      } finally {
        setLoading(false);
      }
    };

    fetchJobs();
  }, []);

  const getJobStatus = (status: Job["status"]) => {
    switch (status) {
      case "DRAFT":
        return "下書き";
      case "READY":
        return "掲載準備完了";
      case "PUBLISHED":
        return "掲載中";
      case "CLOSED":
        return "掲載終了";
      default:
        return status;
    }
  };

  const getMediaStatus = (status: JobMedia["status"]) => {
    switch (status) {
      case "PUBLISHED":
        return "掲載中";
      case "PENDING":
        return "処理中";
      case "ERROR":
        return "エラー";
      case "CLOSED":
        return "掲載終了";
      case "NOT_PUBLISHED":
        return "未掲載";
      default:
        return status;
    }
  };

  const getIndeedStatus = (job: Job) => {
    const indeed = job.mediaListings.find(
      (media) => media.media === "INDEED"
    );

    return indeed ? getMediaStatus(indeed.status) : "未登録";
  };

  const filteredJobs = useMemo(() => {
    const keyword = search.trim().toLowerCase();

    return jobs.filter((job) => {
      const matchesSearch =
        !keyword ||
        job.title.toLowerCase().includes(keyword) ||
        job.company.name.toLowerCase().includes(keyword) ||
        job.location.toLowerCase().includes(keyword);

      const matchesStatus =
        statusFilter === "ALL" ||
        job.status === statusFilter;

      return matchesSearch && matchesStatus;
    });
  }, [jobs, search, statusFilter]);

  const jobStats = useMemo(() => {
    return {
      total: jobs.length,
      draft: jobs.filter((job) => job.status === "DRAFT").length,
      ready: jobs.filter((job) => job.status === "READY").length,
      published: jobs.filter((job) => job.status === "PUBLISHED").length,
      closed: jobs.filter((job) => job.status === "CLOSED").length,
      errors: jobs.filter((job) =>
        job.mediaListings.some(
          (media) => media.status === "ERROR"
        )
      ).length,
    };
  }, [jobs]);

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900">
      <header className="border-b border-slate-200 bg-white">
        <div className="flex h-16 items-center justify-between px-6">
          <div>
            <h1 className="text-xl font-bold">
              求人管理
            </h1>

            <p className="mt-1 text-xs text-slate-500">
              登録されている求人を管理します
            </p>
          </div>

          <Link
            href="/jobs/new"
            className="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
          >
            ＋ 新規求人
          </Link>
        </div>
      </header>

      <main className="p-6">
        <section className="rounded-xl border border-slate-200 bg-white p-5">
          <div className="grid gap-4 md:grid-cols-3">
            <div className="md:col-span-2">
              <label className="mb-2 block text-sm font-medium">
                求人を検索
              </label>

              <input
                type="text"
                value={search}
                onChange={(event) =>
                  setSearch(event.target.value)
                }
                placeholder="求人タイトル・企業名・勤務地"
                className="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-100"
              />
            </div>

            <div>
              <label className="mb-2 block text-sm font-medium">
                ステータス
              </label>

              <select
                value={statusFilter}
                onChange={(event) =>
                  setStatusFilter(event.target.value)
                }
                className="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-slate-500"
              >
                {statusOptions.map((option) => (
                  <option
                    key={option.value}
                    value={option.value}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
            </div>
          </div>

          {(search || statusFilter !== "ALL") && (
            <div className="mt-4 flex items-center justify-between border-t border-slate-100 pt-4">
              <p className="text-xs text-slate-500">
                絞り込み中：{filteredJobs.length}件
              </p>

              <button
                type="button"
                onClick={() => {
                  setSearch("");
                  setStatusFilter("ALL");
                }}
                className="text-xs font-medium text-slate-600 underline underline-offset-2 hover:text-slate-900"
              >
                絞り込みをリセット
              </button>
            </div>
          )}
        </section>

        <section className="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white">
          <div className="flex items-center justify-between border-b border-slate-200 px-5 py-4">
            <div>
              <h2 className="font-semibold">
                求人一覧
              </h2>

              <p className="mt-1 text-xs text-slate-500">
                {loading
                  ? "読み込み中..."
                  : `${filteredJobs.length}件の求人`}
              </p>
            </div>

            {!loading && jobs.length !== filteredJobs.length && (
              <p className="text-xs text-slate-400">
                全{jobs.length}件中
              </p>
            )}
          </div>

          {loading && (
            <div className="p-10 text-center text-sm text-slate-500">
              求人情報を読み込んでいます...
            </div>
          )}

          {error && (
            <div className="m-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
              {error}
            </div>
          )}

          {!loading && !error && filteredJobs.length === 0 && (
            <div className="p-10 text-center">
              <p className="text-sm font-medium text-slate-700">
                {jobs.length === 0
                  ? "登録されている求人はありません。"
                  : "条件に一致する求人がありません。"}
              </p>

              {jobs.length > 0 && (
                <button
                  type="button"
                  onClick={() => {
                    setSearch("");
                    setStatusFilter("ALL");
                  }}
                  className="mt-3 text-xs font-medium text-slate-600 underline underline-offset-2"
                >
                  絞り込みをリセット
                </button>
              )}
            </div>
          )}

          {!loading && !error && filteredJobs.length > 0 && (
            <div className="overflow-x-auto">
              <table className="w-full min-w-[1100px] text-sm">
                <thead className="bg-slate-50">
                  <tr className="border-b border-slate-200 text-left">
                    <th className="px-5 py-3 font-medium text-slate-500">
                      求人
                    </th>

                    <th className="px-5 py-3 font-medium text-slate-500">
                      勤務地
                    </th>

                    <th className="px-5 py-3 font-medium text-slate-500">
                      雇用形態
                    </th>

                    <th className="px-5 py-3 font-medium text-slate-500">
                      給与
                    </th>

                    <th className="px-5 py-3 font-medium text-slate-500">
                      Indeed
                    </th>

                    <th className="px-5 py-3 font-medium text-slate-500">
                      その他媒体
                    </th>

                    <th className="px-5 py-3 font-medium text-slate-500">
                      状態
                    </th>

                    <th className="px-5 py-3 font-medium text-slate-500">
                      更新日
                    </th>

                    <th className="px-5 py-3"></th>
                  </tr>
                </thead>

                <tbody>
                  {filteredJobs.map((job) => {
                    const otherMedia = job.mediaListings.filter(
                      (media) => media.media !== "INDEED"
                    );

                    return (
                      <tr
                        key={job.id}
                        className="border-b border-slate-100 last:border-0 hover:bg-slate-50"
                      >
                        <td className="px-5 py-4">
                          <div>
                            <p className="font-semibold">
                              {job.title}
                            </p>

                            <p className="mt-1 text-xs text-slate-500">
                              {job.company.name}
                            </p>
                          </div>
                        </td>

                        <td className="px-5 py-4 text-slate-600">
                          {job.location}
                        </td>

                        <td className="px-5 py-4 text-slate-600">
                          {job.employmentType}
                        </td>

                        <td className="px-5 py-4 text-slate-600">
                          {job.salary}
                        </td>

                        <td className="px-5 py-4">
                          <span
                            className={`whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-medium ${
                              getIndeedStatus(job) === "掲載中"
                                ? "bg-green-100 text-green-700"
                                : getIndeedStatus(job) === "エラー"
                                  ? "bg-red-100 text-red-700"
                                  : "bg-slate-100 text-slate-600"
                            }`}
                          >
                            {getIndeedStatus(job)}
                          </span>
                        </td>

                        <td className="px-5 py-4">
                          <div className="flex flex-wrap gap-1.5">
                            {otherMedia.length === 0 ? (
                              <span className="text-xs text-slate-400">
                                未登録
                              </span>
                            ) : (
                              otherMedia.map((media) => (
                                <span
                                  key={media.id}
                                  className="whitespace-nowrap rounded-full bg-slate-100 px-2 py-1 text-[11px] text-slate-600"
                                  title={getMediaStatus(media.status)}
                                >
                                  {mediaNames[media.media]}：{getMediaStatus(media.status)}
                                </span>
                              ))
                            )}
                          </div>
                        </td>

                        <td className="px-5 py-4">
                          <span className="whitespace-nowrap rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
                            {getJobStatus(job.status)}
                          </span>
                        </td>

                        <td className="px-5 py-4 text-slate-500">
                          {new Date(
                            job.updatedAt
                          ).toLocaleDateString("ja-JP")}
                        </td>

                        <td className="px-5 py-4">
                          <Link
                            href={`/jobs/${job.id}`}
                            className="whitespace-nowrap rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium hover:bg-slate-100"
                          >
                            詳細
                          </Link>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </main>
    </div>
  );
}
